root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python files (aligned with Ruff: 4 spaces, line-length 100)
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# TOML configuration files
[*.toml]
indent_style = space
indent_size = 4

# YAML configuration files
[*.{yaml,yml}]
indent_style = space
indent_size = 2

# JSON data and fixtures
[*.json]
indent_style = space
indent_size = 2

# Markdown documentation (preserve intentional trailing spaces for markdown line breaks)
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Windows shell and command scripts (require CRLF)
[*.{bat,cmd,ps1}]
end_of_line = crlf

